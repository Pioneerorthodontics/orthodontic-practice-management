    var label = { payment: 'دفعة', charge: 'رسوم إضافية', discount: 'خصم', refund: 'استرداد' }[type];
    audit(s, ctx, 'tx.add', label + ' ' + money(d.amt) + ' — ' + p.name + ' — ' + s.get('clinics', d.cid).name + (e.note ? ' — ' + e.note : ''));
    return { id: e.id };
  };

