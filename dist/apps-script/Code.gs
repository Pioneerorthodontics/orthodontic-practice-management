    if (method !== 'fixed' && !(pct > 0 && pct <= 100 && Math.round(pct * 100) === pct * 100)) fail('نسبة الطبيب يجب أن تكون بين ١ و ١٠٠ (حتى رقمين عشريين).');
    if (method !== 'pct' && !(fee > 0 && fee === Math.floor(fee))) fail('اكتب المبلغ الثابت لكل زيارة.');
