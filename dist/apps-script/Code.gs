    s.insert('appts', a, ctx);
    audit(s, ctx, 'appt.create', 'موعد ' + p.name + ' — ' + s.get('clinics', a.cid).name + ' — ' + a.date + ' ' + a.time + (a.status === 'attended' ? ' (حالة بدون موعد)' : ''));
