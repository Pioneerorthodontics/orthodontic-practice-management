/* =========================================================
 * Web API
 * ========================================================= */
function doGet() {
  return ContentService.createTextOutput(JSON.stringify({ ok: true, app: 'ortho', version: APP_VERSION })).setMimeType(ContentService.MimeType.JSON);
}
function doPost(e) {
