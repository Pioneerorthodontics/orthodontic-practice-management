    s.insert('agreements', { id: 'ag-' + d.id, cid: d.id, from: from, to: '', method: 'pct', pct: d.pct == null ? 70 : +d.pct, fee: 0, lab: LAB_RULES.indexOf(d.lab) >= 0 ? d.lab : 'deduct', notes: '' }, ctx);
